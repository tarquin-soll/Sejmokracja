title: Inter-politics
new-page: true
is-special: true
on-arrival: {!
var _newData = [];
    function _addP(id, legend, seats) {
        if (seats && seats > 0) _newData.push({ id: id, legend: legend, name: legend, seats: seats });
    }
    _addP('kpp', "KPP", Q.kpp_sj);
    _addP('pps', 'PPS', Q.pps_sj);
    _addP('npr', 'NPR', Q.npr_sj);
    _addP('psl_l', 'PSL-L', Q.psl_l_sj);
    _addP('psl_w', 'PSL-W', Q.psl_w_sj);
    _addP('psl_p',  'PSL-P',  Q.psl_p_sj);
    _addP('bmn', 'BMN', Q.bmn_sj);
    _addP('chzjn', 'ChZJN', Q.chzjn_sj);
    _addP('zln', 'ZLN', Q.zln_sj);
    _addP('pschd', 'PSChD', Q.pschd_sj);
    _addP('otherright', 'Other Parties', Q.otherright_sj);
    _addP('other','Other',Q.other_sj);

    var _newSig = JSON.stringify(_newData.map(function(p){ return p.id + p.seats; }));
    var _changed = (_newSig !== window._parliSig);
    window._parliData = _newData;
    if (_changed) {
        window._parliSig = _newSig;
        window._parliAnimate = true;
    } else {
        window._parliAnimate = false;
    }
!}

= Parliament

<div style="text-align: center;">**Sejm**</div>

{!<svg id="status_parliament" style="width: 100%; display: block;"></svg>
<script>
(function() {
    if (!d3 || !d3.parliament || !window._parliData || window._parliData.length === 0) return;
    var el = document.getElementById('status_parliament');
    if (!el) return;
    var w = el.parentElement.offsetWidth || 220;
    el.setAttribute('width', w);
    el.setAttribute('height', Math.round(w * 0.55));
    var parl = d3.parliament();
    parl.width(w).height(Math.round(w * 0.55)).innerRadiusCoef(0.4);
    var animate = window._parliAnimate;
    parl.enter.fromCenter(animate).smallToBig(animate);
    parl.exit.toCenter(animate).bigToSmall(animate);
    d3.select('#status_parliament').datum(window._parliData).call(parl);
})();
</script>!}

Government Mandate: [+ government_mandate +]/100%

{!<table>!} 
{!<tr><td>Party</td><td>Mandate</td><td>Status</td></tr>!}
{!<tr><td><div class="box" style='background-color:#890000;'> </div> !} KPP: {!</td><td>!} [+ kpp_sj +]% {!</td><td>!} [? if kpp_in_government = 0 and kpp_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if kpp_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if kpp_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#C62828; outline: 2px; outline-style: solid;'> </div> !} **PPS**: {!</td><td>!} [+ pps_sj +]% {!</td><td>!} [? if pps_in_government = 0 and pps_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if pps_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if pps_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#841839;'> </div> !} NPR: {!</td><td>!} [+ npr_sj +]% {!</td><td>!} [? if npr_in_government = 0 and npr_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if npr_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if npr_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#80FF00;'> </div> !} PSL-L: {!</td><td>!} [+ psl_l_sj +]% {!</td><td>!} [? if psl_l_in_government = 0 and psl_l_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if psl_l_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if psl_l_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#179900;'> </div> !} PSL-W: {!</td><td>!} [+ psl_w_sj +]% {!</td><td>!} [? if psl_w_in_government = 0 and psl_w_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if psl_w_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if psl_w_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#3A6538;'> </div> !} PSL-P: {!</td><td>!} [+ psl_p_sj +]% {!</td><td>!} [? if psl_p_in_government = 0 and psl_p_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if psl_p_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if psl_p_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#E3AF34;'> </div> !} BMN: {!</td><td>!} [+ bmn_sj +]% {!</td><td>!}[? if bmn_in_government = 0 and bmn_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if bmn_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if bmn_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td style="padding-left:26px;">!}- ZLN: {!</td><td>!} [+ zln_sj +]% {!</td><td>!} [? if zln_in_government = 0 and zln_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if zln_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if zln_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td style="padding-left:26px;">!}- PSChD: {!</td><td>!} [+ pschd_sj +]% {!</td><td>!} [? if pschd_in_government = 0 and pschd_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if pschd_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if pschd_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td style="padding-left:26px;">!}- Other parties: {!</td><td>!} [+ otherright_sj +]% {!</td><td>!} [? if otherright_in_government = 0 and otherright_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if otherright_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if otherright_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}

{!<tr><td><div class="box" style='background-color:#909090;'> </div> !} Other: {!</td><td>!} [+ other_sj +]% {!</td><td>!} [? if other_in_government = 0 and other_toleration = 0 : <span style="color: #D42F2F;">Opposition</span> ?][? if other_in_government = 1 : <span style="color: #66BB6A;">In Government</span> ?][? if other_toleration = 1 : <span style="color: #FFB74D;">Toleration</span> ?] {!</td></tr>!}
{!</table>!}

[? if year >= 1923 : <div style="text-align: center;">**Senate**</div> ?]
