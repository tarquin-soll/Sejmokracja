{!<tr><td style="padding-left:26px;"><div class="box" style='background-color:#A0A0E0'></div> !}Other parties: {!</td><td>!} [+ otherright_sn +]% {!</td><td>!} [? if year >= 1923 : **[+ str_change_otherright_sn +]** ?][? if year < 1923 : *NEW* ?] {!</td></tr>!}

