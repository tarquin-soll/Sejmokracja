title: Senat Elections
new-page: true
tags: event
priority: -2
view-if: senat_seen == 0
on-departure: senat_seen = 1
face-image: img/fl_pl.webp

= Elections, [+ month : month +] [+ year +]

The Senat elections are to be held now.

- @senat: May we do our best...

@senat
on-arrival: {!
var senat_adjustment_factor = {
    kpp: 0.3,
    pps: 0.7,
    npr: 1.0,
    psl_l: 0.2,
    psl_w: 0.7,
    psl_p: 1.0,
    bmn: 1.2,
    zln: 1.4,
    pschd: 0.9,
    other: 0.2,
    otherright: 0.3,
};

Q.kpp_sn_votes = Q.kpp_votes*senat_adjustment_factor.kpp;
Q.pps_sn_votes = Q.pps_votes*senat_adjustment_factor.pps;
Q.npr_sn_votes = Q.npr_votes*senat_adjustment_factor.npr;
Q.psl_l_sn_votes = Q.psl_l_votes*senat_adjustment_factor.psl_l;
Q.psl_w_sn_votes = Q.psl_w_votes*senat_adjustment_factor.psl_w;
Q.psl_p_sn_votes = Q.psl_p_votes*senat_adjustment_factor.psl_p;
Q.bmn_sn_votes = Q.bmn_votes*senat_adjustment_factor.bmn;
Q.zln_sn_votes = Q.zln_votes*senat_adjustment_factor.zln;
Q.pschd_sn_votes = Q.pschd_votes*senat_adjustment_factor.pschd;
Q.other_sn_votes = Q.other_votes*senat_adjustment_factor.other;
Q.otherright_sn_votes = Q.otherright_votes*senat_adjustment_factor.otherright;

Q.total_votes_sn = Q.kpp_sn_votes + Q.pps_sn_votes + Q.npr_sn_votes + Q.psl_l_sn_votes + Q.psl_w_sn_votes + Q.psl_p_sn_votes + Q.bmn_sn_votes + Q.zln_sn_votes + Q.pschd_sn_votes + Q.other_sn_votes + Q.otherright_sn_votes

if (Q.total_votes_sn > 0) {
    Q.kpp_sn_votes = parseFloat(((Q.kpp_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.pps_sn_votes = parseFloat(((Q.pps_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.npr_sn_votes = parseFloat(((Q.npr_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.psl_l_sn_votes = parseFloat(((Q.psl_l_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.psl_w_sn_votes = parseFloat(((Q.psl_w_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.psl_p_sn_votes = parseFloat(((Q.psl_p_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.bmn_sn_votes = parseFloat(((Q.bmn_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.zln_sn_votes = parseFloat(((Q.zln_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.pschd_sn_votes = parseFloat(((Q.pschd_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.other_sn_votes = parseFloat(((Q.other_sn_votes/Q.total_votes_sn)*100).toFixed(1));
    Q.otherright_sn_votes = parseFloat(((Q.otherright_sn_votes/Q.total_votes_sn)*100).toFixed(1));
}

var new_party_sum = 0;
for (var party of Q.parties) {
    new_party_sum += Q[party + '_sn'];
    Q['old_' + party + '_sn'] = Q[party + '_sn'];
    if (Q[party + '_sn_votes'] < Q.electoral_threshold || (Q.electoral_threshold > 1 && party == 'other') || (Q.electoral_threshold > 1 && party == 'otherright') || Q[party + '_banned'] || Q[party + '_boycott']) {
        Q[party + '_sn'] = 0;
    } else {
        Q[party + '_sn'] = Q[party + '_sn_votes'];
    }
    Q[party + '_sn_disp'] = Q[party + '_sn'].toFixed(1);
    Q['change_' + party + '_sn'] = Q[party + '_sn'] - Q['old_' + party + '_sn'];
    var sign = Q['change_' + party + '_sn'] > 0 
                   ? '<img src="img/arrowup.png"> ' 
                   : Q['change_' + party + '_sn'] < 0 
                     ? '<img src="img/arrowdown.png"> ' 
                     : '<img src="img/steady.png"> ';
    Q['str_change_' + party + '_sn'] = sign + Q['change_' + party + '_sn'].toFixed(1);
};

Q.left_sn = Q.kpp_sn + Q.pps_sn + (Q.npr_sn*0.4) + Q.psl_l_sn + (Q.psl_w_sn*0.3);
Q.center_sn = (Q.psl_w_sn*0.7) + (Q.psl_p_sn*0.6) + Q.bmn_sn + Q.other_sn;
Q.right_sn = (Q.npr_sn*0.6) + Q.otherright_sn + Q.zln_sn + Q.pschd_sn + (Q.psl_p_sn*0.4);

Q.left_dominant_sn = 0;
Q.center_dominant_sn = 0;
Q.right_dominant_sn = 0;

if ((Q.left_sn > Q.center_sn) && (Q.left_sn > Q.right_sn)){
    Q.left_dominant_sn = 1;
}
if ((Q.center_sn > Q.left_sn) && (Q.center_sn > Q.right_sn)){
    Q.center_dominant_sn = 1;
}
if ((Q.right_sn > Q.left_sn) && (Q.right_sn > Q.center_sn)){
    Q.right_dominant_sn = 1;
}
!}
on-display: {!
data_sn = [
    {
        "id": "kpp",
        "legend": "KPP",
        "name": "KPP",
        "seats": Math.round(Q.kpp_sn*1.11),
    },
    {
        "id": "pps",
        "legend": "PPS",
        "name": "PPS",
        "seats": Math.round(Q.pps_sn*1.11),
    },
    {
        "id": "npr",
        "legend": "NPR",
        "name": "NPR",
        "seats": Math.round(Q.npr_sn*1.11),
    },
    {
        "id": "psl_l",
        "legend": "PSL-L",
        "name": "PSL-L",
        "seats": Math.round(Q.psl_l_sn*1.11),
    },
    {
        "id": "psl_w",
        "legend": "PSL-W",
        "name": "PSL-W",
        "seats": Math.round(Q.psl_w_sn*1.11),
    },
    {
        "id": "psl_p",
        "legend": "PSL-P",
        "name": "PSL-P",
        "seats": Math.round(Q.psl_p_sn*1.11),
    },
    {
        "id": "bmn",
        "legend": "BMN",
        "name": "BMN",
        "seats": Math.round(Q.bmn_sn*1.11),
    },
    {
        "id": "other",
        "legend": "Other",
        "name": "Other",
        "seats": Math.round(Q.other_sn*1.11),
    },
    {
        "id": "otherright",
        "legend": "Other Parties",
        "name": "Other Parties",
        "seats": Math.round(Q.otherright_sn*1.11),
    },
    {
        "id": "pschd",
        "legend": "PSChD",
        "name": "PSChD",
        "seats": Math.round(Q.pschd_sn*1.11),
    },
    {
        "id": "zln",
        "legend": "ZLN",
        "name": "ZLN",
        "seats": Math.round(Q.zln_sn*1.11),
    },
];

Q.sn_display = data_sn

if (window && d3) {
    var width = 500; 
    var height = 500;
    var screenWidth = document.getElementById('content').offsetWidth;
    if (screenWidth < width - 50) {
        width = screenWidth - 50; 
        height = width;
        document.getElementById("senat").style.height = screenWidth/2 + "px";
    } 

    var parliament = d3.parliament();
    parliament.width(width).height(height).innerRadiusCoef(0.4);
    parliament.enter.fromCenter(true).smallToBig(true);
    parliament.exit.toCenter(false).bigToSmall(true);
    d3.select("#senat").datum(data_sn).call(parliament);
}
!}

