@add_barlicki
title: Norbert Barlicki
subtitle: Norbert Barlicki is one of the few who has a background in rural and agricultural affairs in the PPS due to his history in participating in agricultural unions. {!<br><br>!}[? if difficulty < 0 : Actions - Rural Campaign, Agricultural Policy ?]

is-card: true
card-image: img/portraits/BarlickiNorbert.jpg
tags: labor_advisor
view-if: barlicki_advisor = 0 and n_advisors < 3 and unions_independent = 0
on-arrival: barlicki_advisor = 1; n_advisors += 1; labor_strength += 5
go-to: advisor_menu

